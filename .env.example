# Copy to .env for local development. Never commit .env.

# Local development only. Leave off in production.
DEBUG=True

# Required when DEBUG is off. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# SECRET_KEY=

# Comma separated. Required when DEBUG is off.
# ALLOWED_HOSTS=api.example.com

# On by default when DEBUG is off: trusts the X-Forwarded-Proto header a TLS-terminating
# reverse proxy or load balancer sets, so SECURE_SSL_REDIRECT doesn't redirect-loop behind
# one. Set to False only if this process receives TLS connections directly, with no proxy
# in front of it.
# TRUST_PROXY_SSL_HEADER=True

# Defaults to a local SQLite file. Use Postgres in production:
# DATABASE_URL=postgres://user:password@host:5432/schoolos

# With no REDIS_URL, Django's cache is per-process local memory: fine for one worker, but the
# DRF rate-limit throttles share it, so with N gunicorn workers the real ceiling is N times
# looser than configured. Set this in production so every worker shares one cache:
# REDIS_URL=redis://:password@127.0.0.1:6379/1

# School web addresses. Every school gets <short-name>.PLATFORM_DOMAIN.
# PLATFORM_DOMAIN=schoolos.ng
# So Android can open emailed links in the app (both needed):
# ANDROID_APP_PACKAGE=ng.schoolos.app
# ANDROID_CERT_SHA256=AA:BB:...,CC:DD:...

# Email. In development it prints to the console. In production, set this or every
# invitation email will fail (and say so in the audit trail):
# EMAIL_URL=smtp://user:password@smtp.example.com:587/?tls=True
# DEFAULT_FROM_EMAIL=SkulGen <no-reply@skulgen.com>
# How long an invitation link works, in days, and a host to use in links for a
# school that has no web address yet.
# INVITATION_TTL_DAYS=14
# INVITATION_FALLBACK_HOST=

# SkulGen SaaS payments. The secret stays on the backend only.
# PAYSTACK_SECRET_KEY=sk_test_...
# PAYSTACK_API_BASE_URL=https://api.paystack.co
# Optional fully-qualified page to return to after hosted checkout.
# PAYSTACK_CALLBACK_URL=https://schoolos.ng/billing/payment-return
# Configure Paystack's dashboard webhook URL as:
#   https://<your-api-host>/api/v1/billing/webhooks/paystack/

# Push notifications (apps.notifications.push_delivery), via Firebase Cloud Messaging.
# FIREBASE_PROJECT_ID is the Firebase project id; FIREBASE_CREDENTIALS_JSON is the
# downloaded service-account key, as one line of JSON. Leave both unset until a real
# Firebase project exists - sends honestly refuse rather than pretending to deliver.
# FIREBASE_PROJECT_ID=skulgen-prod
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"skulgen-prod",...}

# Hours before an owner's block takes effect even if the person's app has not
# reported back. The app normally fetches and submits first, then confirms.
# ACCESS_BLOCK_GRACE_HOURS=48

# Accept sync of entity types that have no handler (see apps/sync/registry.py).
# Defaults to on in DEBUG and off otherwise. Keep it off in production.
# SYNC_ALLOW_UNLISTED_ENTITY_TYPES=False
