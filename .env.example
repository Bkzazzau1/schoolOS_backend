# Copy to .env for local development. Never commit .env.

# Local development only. Leave off in production.
DEBUG=True

# Required when DEBUG is off. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# SECRET_KEY=

# Comma separated. Required when DEBUG is off.
# ALLOWED_HOSTS=api.example.com

# Defaults to a local SQLite file. Use Postgres in production:
# DATABASE_URL=postgres://user:password@host:5432/schoolos

# Accept sync of entity types that have no rules in apps/sync/policy.py.
# Defaults to on in DEBUG and off otherwise. Keep it off in production.
# SYNC_ALLOW_UNLISTED_ENTITY_TYPES=False
